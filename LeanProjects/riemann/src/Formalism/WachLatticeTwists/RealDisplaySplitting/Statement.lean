      (∀ w ∈ what₂, F c w = ⊥ ∧
        RowTBW ℓ (blockRestrictedRepresentationType bl ρk c) r χ E ((decs Ek Aw) w) (F c w) (uT w) (wT w) (sT w) (mT w)
