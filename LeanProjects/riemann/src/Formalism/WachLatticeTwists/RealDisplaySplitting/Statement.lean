          Ine (F := Ek) (Av v) ≤ J.map ((decs Ek Aw) w).subtype)) →

    (∀ (Kc : ∀ l, Fin (j (colIdx l)) → (Ω ≃ₐ[Ek] Ω) → R') (k0 : ι → (Ω ≃ₐ[Ek] Ω) → R'),
