      (∀ l, Speck (blockRestrictedRepresentationType bl ρk c1) r χ E δO ((decs Ek Aw) (colIdx l)) incE (HfE₁ l) ℓ (e' (colIdx l)) (u l)
        (k0 l)) →
      ∀ (c : Fin (t + 1)) φ, Submodule.mkQ _ (colPsi (O := O) (M := blockRestrictedRepresentationType bl ρk c) r χ E e₁ δ
        (fun l => (decs Ek Aw) (colIdx l)) (fun l => j (colIdx l)) Kc k0 φ) ∈ lcH1 (uRep O (M := blockRestrictedRepresentationType bl ρk c) r χ)) →
    (lhs ≤
      ∑ w ∈ what₂, Module.length O (Fs w ⧸ (Im w).comap (Fs w).subtype) +
        ∑ w ∈ cols, (eO * (e' w : ℕ∞) + (j w : ℕ∞) * (eO * (e' w : ℕ∞) + vδ) + 2 * vδ + h0 w) + s +
        ∑ e ∈ Finset.Ioo 0 t, Sha e + eO * (padicValNat ℓ (classNumber Ek) : ℕ∞) +
        (t : ℕ∞) * eO * (cB : ℕ∞) * ∑ w ∈ what₂, ((locDeg (pl w) : ℕ∞) + 2) +
        4 * (N + t) * ((cols.card : ℕ∞) + 1) * vδ +
        (t : ℕ∞) * (cols.card : ℕ∞) * H0 + (t : ℕ∞) * ∑ w ∈ qs, IsDiscreteValuationRing.addVal O (ζO w - 1)) ∧
    vδ = eO * ((∑ i ∈ Finset.Ioo 0 t, (s₀ + padicValNat ℓ i) : ℕ) : ℕ∞) ∧
    vδ ≤ eO * ((t * s₀ + padicValNat ℓ t.factorial : ℕ) : ℕ∞)

def PrimOver (ℓ : ℕ) [Fact ℓ.Prime] (O O' : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [CommRing O'] [IsDomain O'] [IsDiscreteValuationRing O'] [Algebra O O'] (e : ℕ) {X d : Type}
    [Fintype d] [DecidableEq d] (Ek Ω : Type) [Field Ek] [NumberField Ek] [Field Ω] [Algebra Ek Ω]
    [IsAlgClosure Ek Ω] (T : Subalgebra O (X → O)) (r : (Ω ≃ₐ[Ek] Ω) →* (X → Matrix d d O))
    (π : X) (t : ℕ) (ht : 1 ≤ t) (bl : d → Fin (t + 1)) (χ₁ ε : (Ω ≃ₐ[Ek] Ω) →* Oˣ) (g₀ : (Ω ≃ₐ[Ek] Ω))
    (eB e₁ s : X → Matrix d d O) : Prop :=
  ∃ D : RingData O' X d (Ω ≃ₐ[Ek] Ω) t bl,
    RingDef O' (bcT O' T) (bcR O' r) π (bcChar O' χ₁) (bcChar O' ε) g₀ (bcM O' eB) (bcM O' e₁)
      (bcM O' s) D ∧
    Module.length O' (O' ⧸ Ideal.span {(ℓ : O')}) = e * Module.length O (O ⧸ Ideal.span {(ℓ : O)}) ∧
    IsDiscreteValuationRing.addVal O' D.δO = e * IsDiscreteValuationRing.addVal O
      (∏ i ∈ Finset.Ioo 0 t, ((χ₁ g₀ : O) - (χ₁ g₀ : O) * (((ε g₀)⁻¹ ^ i : Oˣ) : O))) ∧
    SurjectionRankOneIdempotent O' D.R' {a // bl a = 0} (D.ρk 0).toRingHom D.e₁ ∧
    ScalarActionOnBlock O' D.R' (blockRestrictedRepresentationType bl D.ρk (⟨1, by omega⟩ : Fin (t + 1))) D.E D.δO ∧
    ∃ (_ : IsNoetherian D.R' D.R') (_ : ∀ x', IsScalarTower D.T' D.R' (EvalSp O' d D.R' x'))
      (_ : ∀ k, SMulCommClass D.R' O' (blockRestrictedRepresentationType bl D.ρk k))
      (_ : ∀ k, IsScalarTower D.T' D.R' (blockRestrictedRepresentationType bl D.ρk k))
      (_ : ∀ k, IsScalarTower O' D.R' (blockRestrictedRepresentationType bl D.ρk k)),
      ∀ [Algebra ℤ_[ℓ] O'] [Module.Finite ℤ_[ℓ] O'] [TopologicalSpace O']
        [TopologicalSpace (FractionRing O')] [IsTopologicalAddGroup (FractionRing O')]
        [ContinuousSMul O' (FractionRing O')] [TopologicalSpace D.R'] [IsTopologicalAddGroup D.R']
        [ContinuousConstSMul O' D.R'] [ContinuousMul D.R'] (Z : Set X),
        RealDisplay2 ℓ O' X D.X' Z D.p d D.R' D.T' Ek Ω D.r D.χ D.E D.e₁ D.δ t ht bl D.ρk D.δO
          (bcChar O' ε) g₀ (e * vcc T Z π) ∧
        RealDisplayWA ℓ O' X D.X' Z D.p d D.R' D.T' Ek Ω D.r D.χ D.E D.e₁ D.δ t ht bl D.ρk D.δO
          (bcChar O' ε) g₀ (e * vcc T Z π) ∧
        RealDisplayAll2 ℓ O' X D.X' Z D.p d D.R' D.T' Ek Ω D.r D.χ D.E D.e₁ D.δ t ht bl D.ρk D.δO
          (bcChar O' ε) g₀ (e * vcc T Z π) ∧
        RealDisplayAllWA ℓ O' X D.X' Z D.p d D.R' D.T' Ek Ω D.r D.χ D.E D.e₁ D.δ t ht bl D.ρk D.δO
          (bcChar O' ε) g₀ (e * vcc T Z π)

def GaloisTheoremPrimitiveData : Prop :=
  ∀ (ℓ : ℕ) [Fact ℓ.Prime] (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] (X : Type) [Fintype X] (T : Subalgebra O (X → O))
    (d : Type) [Fintype d] [DecidableEq d] (Ek Ω : Type) [Field Ek] [NumberField Ek] [Field Ω]
    [Algebra Ek Ω] [IsAlgClosure Ek Ω] (r : (Ω ≃ₐ[Ek] Ω) →* (X → Matrix d d O)) (π : X)
    (t : ℕ) (ht : 1 ≤ t) (bl : d → Fin (t + 1)) (χ₁ ε : (Ω ≃ₐ[Ek] Ω) →* Oˣ) (g₀ : (Ω ≃ₐ[Ek] Ω)),
    ChainHyp O T r π bl χ₁ ε g₀ → ∀ (L : ℕ) (ϖ : O), ϖ ≠ 0 →
    ∃ eB e₁ s : X → Matrix d d O, ChainAB O T r π bl g₀ (ϖ ^ L) eB e₁ s ∧
      ∀ (O' : Type) [CommRing O'] [IsDomain O'] [IsDiscreteValuationRing O'] [Algebra O O']
        [Module.Free O O'] [Module.Finite O O'] (e : ℕ),
        (∀ y : O, IsDiscreteValuationRing.addVal O' (algebraMap O O' y) =
          e * IsDiscreteValuationRing.addVal O y) →
        (∀ x, ((blockPoly (eB x) (eB x * r g₀ x * eB x + s x)).map
          ((algebraMap O' (FractionRing O')).comp (algebraMap O O'))).Splits) →
        PrimOver ℓ O O' e Ek Ω T r π t ht bl χ₁ ε g₀ eB e₁ s

def GaloisTheoremWithExtension : Prop :=
  ∀ (ℓ : ℕ) [Fact ℓ.Prime] (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] (X : Type) [Fintype X] (T : Subalgebra O (X → O))
    (d : Type) [Fintype d] [DecidableEq d] (Ek Ω : Type) [Field Ek] [NumberField Ek] [Field Ω]
    [Algebra Ek Ω] [IsAlgClosure Ek Ω] (r : (Ω ≃ₐ[Ek] Ω) →* (X → Matrix d d O)) (π : X)
    (t : ℕ) (ht : 1 ≤ t) (bl : d → Fin (t + 1)) (χ₁ ε : (Ω ≃ₐ[Ek] Ω) →* Oˣ) (g₀ : (Ω ≃ₐ[Ek] Ω)),
    ChainHyp O T r π bl χ₁ ε g₀ → ∀ (L : ℕ) (ϖ : O), ϖ ≠ 0 →
    ∃ eB e₁ s : X → Matrix d d O, ChainAB O T r π bl g₀ (ϖ ^ L) eB e₁ s ∧
      ∃ (O' : Type) (_ : CommRing O') (_ : IsDomain O') (_ : IsDiscreteValuationRing O')
        (_ : Algebra O O') (_ : Module.Free O O') (_ : Module.Finite O O') (e : ℕ),
        (∀ y : O, IsDiscreteValuationRing.addVal O' (algebraMap O O' y) =
          e * IsDiscreteValuationRing.addVal O y) ∧
        PrimOver ℓ O O' e Ek Ω T r π t ht bl χ₁ ε g₀ eB e₁ s

