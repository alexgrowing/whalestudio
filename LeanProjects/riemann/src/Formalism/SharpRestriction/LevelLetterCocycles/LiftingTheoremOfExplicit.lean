section Orbit

variable {G LL : Type} [Group G] [Field LL] (I : Subgroup G) [hI : I.Normal] (Fr : G)

def frobChar : (I →* LLˣ) →* (I →* LLˣ) :=
  MonoidHom.compHom' (MulAut.conjNormal Fr⁻¹ : I ≃* I).toMonoidHom

end Orbit

