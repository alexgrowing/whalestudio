def TestEx {V : Type} [AddCommGroup V] [TopologicalSpace V] [MeasurableSpace V] (μ : Measure V)
    (χ : V → V → ℂ) : Prop :=
  ∃ Φ : V → ℂ, Continuous Φ ∧ HasCompactSupport Φ ∧
    Integrable (fun y => ∫ x, Φ x * χ x y ∂μ) μ ∧ ∃ z, Φ (-z) ≠ 0

theorem eq_of_testEx {V : Type} [AddCommGroup V] [TopologicalSpace V]
    [IsTopologicalAddGroup V] [LocallyCompactSpace V] [SecondCountableTopology V]
    [MeasurableSpace V] [BorelSpace V] {μ ν : Measure V} {χ : V → V → ℂ}
    (hμ : SelfDual μ χ) (hν : SelfDual ν χ) (hT : TestEx μ χ) : μ = ν := by
  obtain ⟨hμH, hμD⟩ := hμ
  obtain ⟨hνH, hνD⟩ := hν
  obtain ⟨Φ, hc, hs, hi, z, hz⟩ := hT
  have hνeq : ν = ((Measure.addHaarScalarFactor ν μ : NNReal) : ENNReal) • μ :=
    (Measure.isAddLeftInvariant_eq_smul ν μ).trans (ENNReal.smul_def _ _)
  generalize hcdef : ((Measure.addHaarScalarFactor ν μ : NNReal) : ENNReal) = c at hνeq
  have hcT : c ≠ ⊤ := by rw [← hcdef]; exact ENNReal.coe_ne_top
  subst hνeq
  have htr : ∀ y, ∫ x, Φ x * χ x y ∂(c • μ) = c.toReal • ∫ x, Φ x * χ x y ∂μ :=
    fun y => integral_smul_measure _ _
  have hiν : Integrable (fun y => ∫ x, Φ x * χ x y ∂(c • μ)) (c • μ) := by
    simp_rw [htr]
    exact (hi.smul c.toReal).smul_measure hcT
  have e1 := hμD Φ hc hs hi z
  have e2 := hνD Φ hc hs hiν z
  rw [integral_smul_measure] at e2
  simp_rw [htr, smul_mul_assoc, integral_smul, e1] at e2
  have hr : c.toReal * c.toReal = 1 := by
    rw [smul_smul, Complex.real_smul] at e2
    have h3 : ((c.toReal * c.toReal : ℝ) : ℂ) = 1 := mul_right_cancel₀ hz (e2.trans (one_mul _).symm)
    exact_mod_cast h3
  have hr1 : c.toReal = 1 := by
    have hpos : 0 ≤ c.toReal := ENNReal.toReal_nonneg
    nlinarith
  rw [(ENNReal.toReal_eq_one_iff c).mp hr1, one_smul]

def ann {V : Type} (χ : V → V → ℂ) (L : Set V) : Set V := {y | ∀ x ∈ L, χ x y = 1}

section Lattice

variable {V : Type} [AddCommGroup V] [TopologicalSpace V] [IsTopologicalAddGroup V] [T2Space V]
  [MeasurableSpace V] [BorelSpace V] (μ : Measure V) [μ.IsAddHaarMeasure] (χ : V → V → ℂ)
  (hχ : ∀ x t y, χ (t + x) y = χ t y * χ x y) (L : AddSubgroup V)

include hχ in

theorem transform_indicator (hLo : IsOpen (L : Set V)) (y : V) :
    ∫ x, (L : Set V).indicator (fun _ => (1 : ℂ)) x * χ x y ∂μ =
      (ann χ L).indicator (fun _ => ((μ.real (L : Set V) : ℝ) : ℂ)) y := by
  classical
  by_cases hy : y ∈ ann χ L
  · rw [Set.indicator_of_mem hy]
    have e : (fun x => (L : Set V).indicator (fun _ => (1 : ℂ)) x * χ x y) =
        (L : Set V).indicator (fun _ => (1 : ℂ)) := by
      funext x
      by_cases hx : x ∈ (L : Set V)
      · simp [Set.indicator, hx, hy x hx]
      · simp [Set.indicator, hx]
    rw [e, integral_indicator_const _ hLo.measurableSet]
    simp
  · rw [Set.indicator_apply, if_neg hy]
    simp only [ann, Set.mem_setOf_eq, not_forall] at hy
    obtain ⟨t, ht, hty⟩ := hy
    set f : V → ℂ := fun x => (L : Set V).indicator (fun _ => (1 : ℂ)) x * χ x y with hf
    have key : ∫ x, f x ∂μ = χ t y * ∫ x, f x ∂μ := by
      calc ∫ x, f x ∂μ = ∫ x, f (t + x) ∂μ := (integral_add_left_eq_self f t).symm
        _ = ∫ x, χ t y * f x ∂μ := by
          congr 1
          funext x
          by_cases hx : x ∈ (L : Set V)
          · have htx : t + x ∈ L := L.add_mem ht hx
            have hx' : x ∈ L := hx
            simp [hf, Set.indicator, hx', htx, hχ]
          · have htx : t + x ∉ L := fun h => hx (by simpa using L.sub_mem h ht)
            have hx' : x ∉ L := hx
            simp [hf, Set.indicator, hx', htx]
        _ = χ t y * ∫ x, f x ∂μ := integral_const_mul _ _
    have h2 : (1 - χ t y) * ∫ x, f x ∂μ = 0 := by rw [sub_mul, one_mul, ← key, sub_self]
    rcases mul_eq_zero.mp h2 with h1 | h1
    · exact absurd (sub_eq_zero.mp h1).symm hty
    · exact h1

include hχ in

theorem testEx_of_lattice (hLc : IsCompact (L : Set V)) (hLo : IsOpen (L : Set V))
    (hA : IsClosed (ann χ L)) (K : Set V) (hK : IsCompact K) (hAK : ann χ L ⊆ K) :
    TestEx μ χ := by
  refine ⟨(L : Set V).indicator (fun _ => (1 : ℂ)), ?_, ?_, ?_, 0, ?_⟩
  · exact IsClopen.continuous_indicator ⟨AddSubgroup.isClosed_of_isOpen L hLo, hLo⟩ continuous_const
  · exact HasCompactSupport.intro hLc fun x hx => by simp [Set.indicator, hx]
  · have e := funext (transform_indicator μ χ hχ L hLo)
    rw [e]
    have hcomp : IsCompact (ann χ L) := hK.of_isClosed_subset hA hAK
    exact (integrable_indicator_iff hA.measurableSet).2 (continuousOn_const.integrableOn_compact hcomp)
  · simp [Set.indicator]

end Lattice

def AnnAt {V : Type} [AddCommGroup V] [TopologicalSpace V] (χ : V → V → ℂ) : Prop :=
  ∃ L : AddSubgroup V, IsCompact (L : Set V) ∧ IsOpen (L : Set V) ∧ IsClosed (ann χ L) ∧
    ∃ K, IsCompact K ∧ ann χ L ⊆ K

section Triv

variable {V : Type} [AddCommGroup V] [TopologicalSpace V] [IsTopologicalAddGroup V] [T2Space V]
  [MeasurableSpace V] [BorelSpace V] (μ : Measure V) [μ.IsAddHaarMeasure] (χ : V → V → ℂ)

theorem testEx_of_trivial (hχ : ∀ x y, χ x y = 1) (L : AddSubgroup V)
    (hLc : IsCompact (L : Set V)) (hLo : IsOpen (L : Set V)) : TestEx μ χ := by
  classical
  have hLcl : IsClopen (L : Set V) := ⟨AddSubgroup.isClosed_of_isOpen L hLo, hLo⟩
  by_cases hL : ∀ t, t ∈ L
  · have hu : (Set.univ : Set V) = L := (Set.eq_univ_of_forall (s := (L : Set V)) hL).symm
    haveI : IsFiniteMeasure μ := ⟨by rw [hu]; exact hLc.measure_lt_top⟩
    refine ⟨fun _ => 1, continuous_const, HasCompactSupport.intro hLc fun x hx => absurd (hL x) hx,
      ?_, 0, one_ne_zero⟩
    simp_rw [hχ, mul_one]
    exact integrable_const _
  · push_neg at hL
    obtain ⟨t, ht⟩ := hL
    set S : Set V := (fun x => -t + x) ⁻¹' (L : Set V) with hS
    have hScl : IsClopen S := hLcl.preimage (continuous_const.add continuous_id)
    have hSc : IsCompact S := (Homeomorph.addLeft (-t)).isCompact_preimage.2 hLc
    have hSμ : μ S = μ (L : Set V) := measure_preimage_add μ (-t) (L : Set V)
    have hiL : Integrable ((L : Set V).indicator fun _ => (1 : ℂ)) μ :=
      (integrable_indicator_iff hLo.measurableSet).2 (continuousOn_const.integrableOn_compact hLc)
    have hiS : Integrable (S.indicator fun _ => (1 : ℂ)) μ :=
      (integrable_indicator_iff hScl.isOpen.measurableSet).2 (continuousOn_const.integrableOn_compact hSc)
    refine ⟨fun x => (L : Set V).indicator (fun _ => (1 : ℂ)) x - S.indicator (fun _ => (1 : ℂ)) x,
      ?_, ?_, ?_, 0, ?_⟩
    · exact (hLcl.continuous_indicator continuous_const).sub (hScl.continuous_indicator continuous_const)
    · refine HasCompactSupport.intro (hLc.union hSc) fun x hx => ?_
      simp only [Set.mem_union, not_or] at hx
      simp [Set.indicator, hx.1, hx.2]
    · have h0 : (fun y => ∫ x, ((L : Set V).indicator (fun _ => (1 : ℂ)) x -
          S.indicator (fun _ => (1 : ℂ)) x) * χ x y ∂μ) = fun _ => 0 := by
        funext y
        simp_rw [hχ, mul_one]
        rw [integral_sub hiL hiS, integral_indicator_const _ hLo.measurableSet,
          integral_indicator_const _ hScl.isOpen.measurableSet]
        simp [Measure.real, hSμ]
      rw [h0]
      exact integrable_zero _ _ _
    · simp [Set.indicator, hS, ht]

end Triv

section Nontriv

variable {F : Type} [Field F] [NumberField F] (v : HeightOneSpectrum (𝓞 F))

def DualAt {V : Type} [AddCommGroup V] [TopologicalSpace V] (B : V → V → Fv F v) : Prop :=
  ∃ L : AddSubgroup V, IsCompact (L : Set V) ∧ IsOpen (L : Set V) ∧
    (∀ s ∈ v.adicCompletionIntegers F, ∀ x ∈ L, ∃ x' ∈ L, ∀ y, B x' y = s * B x y) ∧
    ∀ c : Fv F v, ∃ K, IsCompact K ∧
      {y | ∀ x ∈ L, B x y ∈ (fun s => c * s) '' (v.adicCompletionIntegers F : Set (Fv F v))} ⊆ K

theorem mem_of_psi (ψ0 : Fv F v → ℂ) (r0 t : Fv F v) (h0 : ψ0 r0 ≠ 1)
    (ht : ∀ s ∈ v.adicCompletionIntegers F, ψ0 (s * t) = 1) :
    t ∈ (fun s => r0 * s) '' (v.adicCompletionIntegers F : Set (Fv F v)) := by
  by_contra hn
  have ht0 : t ≠ 0 := fun h => hn ⟨0, zero_mem _, by simp [h]⟩
  have hs : r0 * t⁻¹ ∉ v.adicCompletionIntegers F := fun hs => h0 (by
    have := ht _ hs
    rwa [inv_mul_cancel_right₀ ht0] at this)
  have hs0 : r0 * t⁻¹ ≠ 0 := fun h => hs (by rw [h]; exact zero_mem _)
  have hr0 : r0 ≠ 0 := fun h => hs0 (by rw [h, zero_mul])
  rw [HeightOneSpectrum.mem_adicCompletionIntegers, not_le] at hs
  have hlt := ((Valued.v : Valuation (Fv F v) _).one_lt_val_iff hs0).mp hs
  refine hn ⟨(r0 * t⁻¹)⁻¹, (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).2 (le_of_lt hlt), ?_⟩
  field_simp

theorem annAt_of_dual {V : Type} [AddCommGroup V] [TopologicalSpace V] (B : V → V → Fv F v)
    (ψ0 : Fv F v → ℂ) (hψ : Continuous ψ0) (hB : ∀ x, Continuous (B x)) (r0 : Fv F v)
    (h0 : ψ0 r0 ≠ 1) (hD : DualAt v B) : AnnAt (fun x y => ψ0 (B x y)) := by
  obtain ⟨L, hLc, hLo, hstab, hbd⟩ := hD
  refine ⟨L, hLc, hLo, ?_, ?_⟩
  · have e : ann (fun x y => ψ0 (B x y)) (L : Set V) = ⋂ x ∈ (L : Set V), {y | ψ0 (B x y) = 1} := by
      ext y
      simp [ann]
    rw [e]
    exact isClosed_biInter fun x _ => isClosed_eq (hψ.comp (hB x)) continuous_const
  · obtain ⟨K, hK, hsub⟩ := hbd r0
    refine ⟨K, hK, fun y hy => hsub ?_⟩
    intro x hx
    apply mem_of_psi v ψ0 r0 (B x y) h0
    intro s hs
    obtain ⟨x', hx', hB'⟩ := hstab s hs x hx
    rw [← hB' y]
    exact hy x' hx'

end Nontriv

section Add

variable {F E : Type} [Field F] [NumberField F] [Field E] [Algebra F E]

open Classical in
theorem singleV_add (v : HeightOneSpectrum (𝓞 F)) (r s : Fv F v) :
    singleV F v (r + s) = singleV F v r + singleV F v s := by
  apply Subtype.ext
  exact Pi.single_add v r s

theorem psiV_add (ψ : AddChar (AF F) ℂ) (v : HeightOneSpectrum (𝓞 F)) (r s : Fv F v) :
    psiV F ψ v (r + s) = psiV F ψ v r * psiV F ψ v s := by
  have e : pairA F 0 (singleV F v (r + s)) =
      pairA F 0 (singleV F v r) + pairA F 0 (singleV F v s) := by
    rw [singleV_add]
    show ((0 : Ainf F), singleV F v r + singleV F v s) =
      ((0 : Ainf F) + 0, singleV F v r + singleV F v s)
    rw [add_zero]
  unfold psiV
  rw [e, AddChar.map_add_eq_mul]

theorem psiInf_add (ψ : AddChar (AF F) ℂ) (r s : Ainf F) :
    psiInf F ψ (r + s) = psiInf F ψ r * psiInf F ψ s := by
  have e : pairA F (r + s) 0 = pairA F r 0 + pairA F s 0 := by
    show (r + s, (0 : Af F)) = (r + s, (0 : Af F) + 0)
    rw [add_zero]
  unfold psiInf
  rw [e, AddChar.map_add_eq_mul]

theorem continuous_singleV (v : HeightOneSpectrum (𝓞 F)) : Continuous (singleV F v) := by
  classical
  have hS : Filter.cofinite ≤ Filter.principal ({v}ᶜ : Set (HeightOneSpectrum (𝓞 F))) :=
    Filter.le_principal_iff.2 (Set.finite_singleton v).compl_mem_cofinite
  let s0 : Fv F v → RestrictedProduct (fun w : HeightOneSpectrum (𝓞 F) => w.adicCompletion F)
      (fun w => (w.adicCompletionIntegers F : Set (w.adicCompletion F)))
      (Filter.principal ({v}ᶜ : Set (HeightOneSpectrum (𝓞 F)))) := fun y =>
    ⟨Pi.single v y, Filter.eventually_principal.2 fun w hw => by
      rw [Pi.single_eq_of_ne (by simpa using hw)]
      exact zero_mem _⟩
  have hc : Continuous s0 := by
    rw [RestrictedProduct.continuous_rng_of_principal_iff_forall]
    intro w
    by_cases hw : w = v
    · subst hw
      exact continuous_id.congr fun y => (Pi.single_eq_same _ _).symm
    · exact (continuous_const (y := (0 : Fv F w))).congr fun y => (Pi.single_eq_of_ne hw y).symm
  have e : singleV F v = fun y => RestrictedProduct.inclusion _ _ hS (s0 y) := by
    funext y
    apply RestrictedProduct.ext
    intro j
    rfl
  rw [e]
  exact (RestrictedProduct.continuous_inclusion hS).comp hc

theorem continuous_psiV (ψ : AddChar (AF F) ℂ) (hψ : Continuous ψ) (v : HeightOneSpectrum (𝓞 F)) :
    Continuous (psiV F ψ v) := by
  unfold psiV
  exact hψ.comp (continuous_const.prodMk (continuous_singleV v))

variable (R : Type) [CommRing R] [Algebra F R]

theorem BR_add (σ : E →ₐ[F] E) {M n : ℕ} (J : Matrix (Fin M) (Fin M) E)
    (X T Y : Fin n → Fin M → R ⊗[F] E) : BR R σ J (T + X) Y = BR R σ J T Y + BR R σ J X Y := by
  simp only [BR, hR, Formalism.UG.hform, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]

theorem pairHerm_add (σ : E →ₐ[F] E) (n : ℕ) (S T U : HermR R σ n) :
    pairHerm R σ n (T + S) U = pairHerm R σ n T U + pairHerm R σ n S U := by
  simp only [pairHerm, AddSubgroup.coe_add, Matrix.add_apply, add_mul, Finset.sum_add_distrib,
    map_add, mul_add]

end Add

section ContY

variable {F E : Type} [Field F] [Field E] [Algebra F E] [FiniteDimensional F E]
  (R : Type) [CommRing R] [Algebra F R] [TopologicalSpace R] [IsTopologicalRing R]
  [LocallyCompactSpace R] [T2Space R]

theorem continuous_trace_tens : Continuous (Algebra.trace R (R ⊗[F] E)) :=
  IsModuleTopology.continuous_of_linearMap _

theorem continuous_BR_right (σ : E →ₐ[F] E) {M n : ℕ} (J : Matrix (Fin M) (Fin M) E)
    (X : Fin n → Fin M → R ⊗[F] E) : Continuous (BR R σ J X) := by
  unfold BR hR Formalism.UG.hform
  refine continuous_finset_sum _ fun a _ => (continuous_trace_tens R).comp ?_
  refine continuous_finset_sum _ fun i _ => continuous_finset_sum _ fun j _ => ?_
  exact continuous_const.mul ((continuous_apply j).comp (continuous_apply a))

theorem continuous_pairHerm_right (σ : E →ₐ[F] E) (n : ℕ) (S : HermR R σ n) :
    Continuous (pairHerm R σ n S) := by
  unfold pairHerm
  refine continuous_const.mul ((continuous_trace_tens R).comp ?_)
  refine continuous_finset_sum _ fun a _ => continuous_finset_sum _ fun b _ => ?_
  exact continuous_const.mul (continuous_subtype_val.matrix_elem b a)

end ContY

