  first | exact @GlobalTheory.DenseCubeExt.exists_cubical_extension | exact GlobalTheory.DenseCubeExt.exists_cubical_extension | (intros; apply GlobalTheory.DenseCubeExt.exists_cubical_extension <;> assumption)
