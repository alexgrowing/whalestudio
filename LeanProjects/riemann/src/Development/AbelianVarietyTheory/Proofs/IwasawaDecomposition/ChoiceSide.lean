    (m.host host) ((frameN)) (m.chrN chrN) (m.chrGal chrGal) ((Pq')) ((Pq_over)) ((pq)) ((jE_eq))
    ((@heq_of_eq (Formalism.L2.MtFam (@D (@withLoc D0 L) m)) (@Mv.mt (@withLoc D0 L) m (@mtL D0 L M)) (@Mv.mt (@withLoc D0 L) m (@Formalism.L2.NGalTied.mt (@withLoc D0 L) (@NAllC.gal (@withLoc D0 L) (@chL D0 L C0) all))) (@congrArg (Formalism.L2.MtFam (@withLoc D0 L)) (Formalism.L2.MtFam (@D (@withLoc D0 L) m)) (@mtL D0 L M) (@Formalism.L2.NGalTied.mt (@withLoc D0 L) (@NAllC.gal (@withLoc D0 L) (@chL D0 L C0) all)) (@Mv.mt (@withLoc D0 L) m) hmt))) ((Pq_eq)) ((hlow)) (m.oSplit split) ((@Mv.ratIn D0 (@pre D0 L m) (@NBuilt.S hL (@withLoc D0 L) (@NTrue.toNBuilt hL (@withLoc D0 L) (@cfL D0 L cf0) (@chL D0 L C0) (@tpL D0 L cf0 C0 tp0) (@NTrue.mk hL (@withLoc D0 L) (@cfL D0 L cf0) (@chL D0 L C0) (@tpL D0 L cf0 C0 tp0) (@NBuilt.mk hL (@withLoc D0 L) D0 cf0 jE A cg au rep row low Pq S hk eig θ Bs M C0 tp0 ch mt big L Sp Au ss (@Eq.refl D7 (@withLoc D0 L))) pack))) ratIn)) ((r1)) ((r2))
