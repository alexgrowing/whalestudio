lemma boxScal_prK_snd {R : Type} [CommRing R] [IsDomain R] {j : ℕ}
    {G G' : Over (Spec (CommRingCat.of R))} [GrpObj G] [IsCommMonObj G] [GrpObj G'] [IsCommMonObj G']
