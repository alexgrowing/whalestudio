  first | exact @GlobalTheory.StdUnn.FockSlice.mem_fockA_of_slices | exact GlobalTheory.StdUnn.FockSlice.mem_fockA_of_slices | (intros; apply GlobalTheory.StdUnn.FockSlice.mem_fockA_of_slices <;> assumption)
