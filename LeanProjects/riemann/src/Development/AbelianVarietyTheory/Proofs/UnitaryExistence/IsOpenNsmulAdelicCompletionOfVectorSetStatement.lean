  first | exact @GlobalTheory.AdLat.OpenLat.isOpen_nsmul_hat | exact GlobalTheory.AdLat.OpenLat.isOpen_nsmul_hat | (intros; apply GlobalTheory.AdLat.OpenLat.isOpen_nsmul_hat <;> assumption)
