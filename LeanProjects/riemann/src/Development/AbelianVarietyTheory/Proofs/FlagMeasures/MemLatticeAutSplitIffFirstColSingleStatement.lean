  first | exact @GlobalTheory.OrbitTerm.mem_autGL_split_iff | exact GlobalTheory.OrbitTerm.mem_autGL_split_iff | (intros; apply GlobalTheory.OrbitTerm.mem_autGL_split_iff <;> assumption)
