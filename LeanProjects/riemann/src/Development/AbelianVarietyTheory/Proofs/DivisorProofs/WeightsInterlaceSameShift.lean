  fun _ _ _ W _ u _ hW _ =>
    ⟨fun τ => GlobalTheory.BranchMembers.interlace W hW.1 u τ, fun τ => GlobalTheory.IndefiniteRowSideFullHecke.InterlacingEquivariance.members_sameShift W hW.1 u τ⟩

