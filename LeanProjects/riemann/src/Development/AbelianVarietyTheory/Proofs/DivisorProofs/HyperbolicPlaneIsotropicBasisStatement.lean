theorem _root_.GlobalTheory.T.hyperbolic_plane_isotropic_basis : ∀ (F E : Type) [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E] (σ : E →ₐ[F] E), IsCMExt F E σ →
    ∀ (hσ : ∀ x, σ (σ x) = x) (n n₁ : ℕ) (W : Spc F E n) (W₁ : Spc F E n₁) (H : Plane E n n₁), (∀ i j, σ (W.J j i) = -W.J i j) → n = n₁ + 2 →
      form σ W.J H.x H.x = 0 → form σ W.J H.y H.y = 0 → form σ W.J H.x H.y = 1 →
      (∀ u, form σ W.J (H.ι *ᵥ u) H.x = 0 ∧ form σ W.J (H.ι *ᵥ u) H.y = 0) → H.ιᵀ * W.J * H.ι.map σ = W₁.J →
      ∀ (c₀ : E) (hc₀ : c₀ ≠ 0), IsHermND σ (c₀ • W₁.J.map σ) → IsHermND σ (c₀ • W.J.map σ) →
      ∀ M : UA σ W₁.J → UA σ W.J, Continuous M → (∀ h₁, IsLevi (W₁ := W₁) H 1 h₁ (M h₁)) →
      ∀ K₁ : Subgroup (GAd σ (c₀ • W₁.J.map σ)), K₁ ≤ infPts σ (c₀ • W₁.J.map σ) → IsCompact (K₁ : Set (GAd σ (c₀ • W₁.J.map σ))) →
      ∃ K : Subgroup (GAd σ (c₀ • W.J.map σ)), K ≤ infPts σ (c₀ • W.J.map σ) ∧ IsCompact (K : Set (GAd σ (c₀ • W.J.map σ))) ∧
        ∀ y ∈ K₁, GlobalTheory.ThK.CuspTransfer.emb hσ W W₁ hc₀ M y ∈ K := by
  first | exact @GlobalTheory.ThK.InducedCons.exists_compact_emb | exact GlobalTheory.ThK.InducedCons.exists_compact_emb | (intros; apply GlobalTheory.ThK.InducedCons.exists_compact_emb <;> assumption)
