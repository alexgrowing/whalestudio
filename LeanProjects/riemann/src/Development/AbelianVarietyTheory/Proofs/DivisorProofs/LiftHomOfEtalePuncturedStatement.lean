  first | exact @GlobalTheory.LiftHom.liftHom_of_etale_punctured | exact GlobalTheory.LiftHom.liftHom_of_etale_punctured | (intros; apply GlobalTheory.LiftHom.liftHom_of_etale_punctured <;> assumption)
