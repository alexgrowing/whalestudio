  first | exact @GlobalTheory.UnitLemma.ShiftRes.val_resultant_shift | exact GlobalTheory.UnitLemma.ShiftRes.val_resultant_shift | (intros; apply GlobalTheory.UnitLemma.ShiftRes.val_resultant_shift <;> assumption)
