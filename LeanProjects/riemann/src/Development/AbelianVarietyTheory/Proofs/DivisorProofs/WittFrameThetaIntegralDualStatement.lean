theorem _root_.GlobalTheory.T.witt_frame_theta_integral_dual : ∀ (F E : Type) [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E] (σ : E →ₐ[F] E)
    (hσ : ∀ x, σ (σ x) = x) (B : Base F E) (a a' : ℕ) (G : Geo σ a a') (X : Chars F E)
    (om : Rep σ G.V G.W) (om' : Rep σ G.V' G.W), GlobalTheory.ThK.KP → IsTriple B G X om om' →
    ∀ (c : E) (hc : c ≠ 0), σ c = -c → ∀ Φ ∈ GlobalTheory.ThK.PolData B G.M,
      ∀ (r : ℕ) (Xf Yf : Matrix (Fin (a + a')) (Fin r) E), IsWittFrame σ (c • G.W.J.map σ) Xf Yf →
        ∀ K, IsMaxCpt σ (c • G.W.J.map σ) K →
          IsAut σ (c • G.W.J.map σ) K (fun x => G.M.I om Φ ((toGAd hσ G.W.J hc).symm x)) →
          ∀ S s, GlobalTheory.StdPar.IsCuspExp σ (c • G.W.J.map σ) Xf Yf S K (fun x => G.M.I om Φ ((toGAd hσ G.W.J hc).symm x)) s →
            (∀ k ∈ S, ∀ i, i ≤ k → i ∈ S) →
            ∀ k ∈ S, ∃ j : ℕ, j ≤ k.val ∧ ((s k).re = (1 - (a : ℝ)) / 2 + j ∨ (s k).re = (1 - (a' : ℝ)) / 2 + j) := by
  first | exact @GlobalTheory.ThK.ExpVExps.re_cuspExp | exact GlobalTheory.ThK.ExpVExps.re_cuspExp | (intros; apply GlobalTheory.ThK.ExpVExps.re_cuspExp <;> assumption)
