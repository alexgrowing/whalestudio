      (∀ h₁ m, IsLevi H' 1 h₁ m → ∃ c : ℂ, ∀ Φ ∈ schA F (Fin n × Fin d), e (om (1, m) Φ) = c • om₁ (1, h₁) (e Φ)) →
      ∀ h₁ m, IsLevi H' 1 h₁ m → ∀ Φ ∈ schA F (Fin n × Fin d), e (om (1, m) Φ) = om₁ (1, h₁) (e Φ) := by
