theorem vac_img : ∀ (F E : Type) [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E] (σ : E →ₐ[F] E) (B : Base F E)
    (b a' : ℕ) (G : Geo σ (b + 2) a') (G₁ : Geo σ b a') (H : Plane E (b + 2) b) (H' : Plane E (b + 2 + a') (b + a'))
    (X : Chars F E) (om : Rep σ G.V G.W) (om' : Rep σ G.V' G.W), CfgA B G G₁ H H' → IsTriple B G X om om' →
    G₁.M.IsGood B.ψ → ∀ e, IsEv B G.M G₁.M H.ι H'.ι (isoA H H') e →
    ∀ (ei : SInf F (Fin (b + 2) × Fin (b + 2 + a')) →L[ℂ] SInf F (Fin b × Fin (b + a')))
      (ev : ∀ v : Pl F, ((Fin (b + 2) × Fin (b + 2 + a') → Fv F v) → ℂ) →ₗ[ℂ] (Fin b × Fin (b + a') → Fv F v) → ℂ),
      (∀ v, ev v (G.M.vac v) = G₁.M.vac v) →
      (∀ f φ, (∀ v, φ v ∈ SB _) → (∀ᶠ v in cofinite, φ v = G.M.vac v) → e (pure f φ) = pure (ei f) fun v => ev v (φ v)) →
    ∀ g, GaussD G.M B.emb g → GaussD G₁.M B.emb (ei g) := by
  intro F E _ _ _ _ _ σ B b a' G G₁ H H' X om om' hC hT hG₁ e he ei ev hev hpure g hg
  exact GlobalTheory.ThK.VacImg.gaussD_of_inter B G.M G₁.M H.ι H'.ι (fun w => (hC.hH.cartan w).1) (fun w => (hC.hH'.cartan w).1) ei
    (fun z f => GlobalTheory.T.standard_evaluation_model_integral F E σ B (b + 2) (b + 2 + a') b (b + a') G.V G.W G₁.V G₁.W G.M G₁.M H.ι H'.ι (isoA H H') e
      hT.base.std hT.geo.hM hG₁ he ei ev hev hpure z f) g hg

end GlobalTheory.ThK.VacImg
