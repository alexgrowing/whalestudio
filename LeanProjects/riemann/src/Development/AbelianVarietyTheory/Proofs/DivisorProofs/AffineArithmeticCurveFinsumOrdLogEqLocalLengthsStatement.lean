  first | exact @GlobalTheory.AffineCurveSum.finsum_ord_eq | exact GlobalTheory.AffineCurveSum.finsum_ord_eq | (intros; apply GlobalTheory.AffineCurveSum.finsum_ord_eq <;> assumption)
