  first | exact @GlobalTheory.PairStep.kltAt_lcAt_of_le_coeff | exact GlobalTheory.PairStep.kltAt_lcAt_of_le_coeff | (intros; apply GlobalTheory.PairStep.kltAt_lcAt_of_le_coeff <;> assumption)
