theorem _root_.GlobalTheory.T.doubled_hermitian_space_signature : ∀ (F E : Type) [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E] (σ : E →ₐ[F] E) (B : Base F E), B.IsGood σ → ∀ (n r s' : ℕ) (X : Spc F E n), X.IsHerm σ B r s' →
    ∀ X₂ : Spc F E (n + n), X₂.J = dblGram finSumFinEquiv X.J → X₂.L = sumLat finSumFinEquiv X.L X.L →
    (∀ w, X₂.θ w = blkMat finSumFinEquiv (X.θ w) (-X.θ w)) →
    ∃ bas, (Spc.mk X₂.J X₂.L X₂.θ bas).IsHerm σ B (r + s') (s' + r) := by
  first | exact @GlobalTheory.DblHerm.exists_isHerm_dbl | exact GlobalTheory.DblHerm.exists_isHerm_dbl | (intros; apply GlobalTheory.DblHerm.exists_isHerm_dbl <;> assumption)
