namespace GlobalTheory.PsiUnrAlmostAll

theorem main : ∀ (F E : Type) [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E]
    (σ : E →ₐ[F] E) (B : Base F E) (n d : ℕ) (X : Spc F E n) (W : Spc F E d) (M : Model σ X W) (χX χW : Chr F E)
    (om : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.Rep σ X W) (r s r' s' : ℕ), IsPair B M χX χW om r s r' s' → ∀ᶠ v in Filter.cofinite, PsiUnr B.ψ v := by
  intro F E _ _ _ _ _ σ B n d X W M χX χW om r s r' s' hP
  have hψ : IsStd B.ψ := hP.base.std
  have hne : differentIdeal ℤ (𝓞 F) ≠ 0 := by rw [Ideal.zero_eq_bot]; exact differentIdeal_ne_bot
  refine Filter.eventually_cofinite.2 ((Ideal.finite_factors hne).subset fun v hv => ?_)
  by_contra h
  exact hv (GlobalTheory.StdCharUnrF.psiUnr_of_not_le F B.ψ hψ v fun hle => h (Ideal.dvd_iff_le.2 hle))

end GlobalTheory.PsiUnrAlmostAll
