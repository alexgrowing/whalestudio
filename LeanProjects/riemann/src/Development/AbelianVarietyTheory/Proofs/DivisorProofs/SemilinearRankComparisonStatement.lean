import Mathlib
set_option maxHeartbeats 1000000 in
theorem _root_.GlobalTheory.T.semilinear_rank_comparison : ∀ (p : ℕ) [Fact p.Prime] (R : Type) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (σ : R →+* R), (∀ r, σ r = r ^ p) → ∀ (D D₁ E E₁ : Type) [AddCommGroup D] [Module R D] [AddCommGroup D₁] [Module R D₁] [AddCommGroup E] [Module R E] [AddCommGroup E₁] [Module R E₁] [Module.Free R D] [Module.Finite R D] [Module.Free R E] [Module.Finite R E] (W : Submodule R D) (U : Submodule R E) (i : D →ₛₗ[σ] D₁) (j : E →ₛₗ[σ] E₁) (F : D₁ →ₗ[R] D) (V : D →ₗ[R] D₁) (F' : E₁ →ₗ[R] E) (V' : E →ₗ[R] E₁) (φ : E →ₗ[R] D) (φ₁ : E₁ →ₗ[R] D₁), (∀ (r : R) (x : D), r ≠ 0 → r • x ∈ W → x ∈ W) → (∀ (r : R) (x : E), r ≠ 0 → r • x ∈ U → x ∈ U) → (∀ (n : ℕ) (b : Module.Basis (Fin n) R D), LinearIndependent R (fun k => i (b k)) ∧ Submodule.span R (Set.range fun k => i (b k)) = ⊤) → (∀ (n : ℕ) (b : Module.Basis (Fin n) R E), LinearIndependent R (fun k => j (b k)) ∧ Submodule.span R (Set.range fun k => j (b k)) = ⊤) → LinearMap.ker F = Submodule.span R (i '' (W : Set D)) → LinearMap.range V = Submodule.span R (i '' (W : Set D)) → LinearMap.ker V = LinearMap.range F → LinearMap.ker F' = Submodule.span R (j '' (U : Set E)) → LinearMap.range V' = Submodule.span R (j '' (U : Set E)) → LinearMap.ker V' = LinearMap.range F' → (∀ x, φ₁ (j x) = i (φ x)) → (∀ x, φ (F' x) = F (φ₁ x)) → (∀ x, φ₁ (V' x) = V (φ x)) → (∀ x ∈ U, φ x ∈ W) → (∀ x ∈ U, φ x = 0 → x = 0) → (∀ x : D, ∃ r : R, r ≠ 0 ∧ r • x ∈ LinearMap.range φ ⊔ W) → (∀ (r : R) (w : D), r ≠ 0 → w ∈ W → r • w ∈ U.map φ → w ∈ U.map φ) ∧ LinearMap.range φ ⊔ W = ⊤ := by
  first | exact @GlobalTheory.HodgeConjLength.saturated_and_surjective | exact GlobalTheory.HodgeConjLength.saturated_and_surjective | (intros; apply GlobalTheory.HodgeConjLength.saturated_and_surjective <;> assumption)
