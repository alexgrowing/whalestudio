theorem _root_.GlobalTheory.T.signature_lieSet_expand_orthonormal_bases : ∀ (n : ℕ) (ε : Fin n → Bool), ∀ U ∈ lieSet ε, U = ∑ b, (trace (U * pB ε b)).re • pB ε b - ∑ i, (trace (U * kB ε i)).re • kB ε i := by
