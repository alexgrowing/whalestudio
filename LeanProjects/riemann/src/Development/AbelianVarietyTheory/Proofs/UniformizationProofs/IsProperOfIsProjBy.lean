theorem isProper_of_isProjBy :
    ∀ (R : Type) [CommRing R] (X : Scheme.{0}) (f : X ⟶ Spec (CommRingCat.of R)), IsProjBy f → IsProper f := by
  intro R _ X f h
  obtain ⟨N, φ, hφ, e⟩ := (GlobalTheory.ProjSpace.isProjBy_iff_isProjOver (R := R) f).1 h
