    (N : Type) [AddCommGroup N] [Module R N] [Module.Flat R N] (f : ∀ (T T' : C) (_ : T ⟶ T'), F.obj T' ⊗[R] N),
    (∀ (T T' T'' : C) (φ : T ⟶ T') (ψ : T' ⟶ T''),
      f T T'' (φ ≫ ψ) = (mp F ψ).toLinearMap.rTensor N (f T T' φ) + f T' T'' ψ) →
    ∃ t : Z1 F ⊗[R] N, ∀ (T T' : C) (φ : T ⟶ T'), (evZ F φ).rTensor N t = f T T' φ := by
