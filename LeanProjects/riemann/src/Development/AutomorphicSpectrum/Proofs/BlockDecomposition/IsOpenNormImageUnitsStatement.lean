theorem _root_.GlobalTheory.T.isOpen_norm_image_units : ∀ (F : Type) [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] [MeasurableSpace F] [BorelSpace F] (E : Type) [Field E] [ValuativeRel E] [TopologicalSpace E] [IsNonarchimedeanLocalField E] [MeasurableSpace E] [BorelSpace E] [Algebra F E] [ValuativeExtension F E] [FiniteDimensional F E] [Algebra.IsSeparable F E] [Fact (Module.finrank F E = 2)], IsOpen {a : F | ∃ t : Eˣ, Algebra.norm F (t : E) = a} ∧ IsOpen {a : F | a ≠ 0 ∧ ¬ ∃ t : Eˣ, Algebra.norm F (t : E) = a} := by
  first | exact @GlobalTheory.CompanionTheory.WcB.NormOpen.isOpen_norms_and_nonnorms | exact GlobalTheory.CompanionTheory.WcB.NormOpen.isOpen_norms_and_nonnorms | (intros; apply GlobalTheory.CompanionTheory.WcB.NormOpen.isOpen_norms_and_nonnorms <;> assumption)
