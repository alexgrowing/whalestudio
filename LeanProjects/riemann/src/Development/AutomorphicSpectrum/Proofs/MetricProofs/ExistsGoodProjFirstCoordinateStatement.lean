    IsCxVar Q e → (∃ z ∈ conePts Q, segre z i ≠ 0) →
    ∃ Ψ : (((k : K) → ι k) → ℂ) →ₗ[ℂ] (Fin (e + 1) → ℂ),
      IsSetGoodProj (conePts Q) Ψ ∧ ∀ w, Ψ w 0 = w i := by
