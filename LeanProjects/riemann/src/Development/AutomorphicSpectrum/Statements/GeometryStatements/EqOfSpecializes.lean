def sabMapId {T : Scheme.{0}} (t : SAB H T) : SABMap t t (𝟙 T) where
  cm := cubeMapId t.G
  cart := isGrpPullback_id t.G
  base := rfl
  act := fun _ => (Category.comp_id _).trans (Category.id_comp _).symm
  lin := isPullCubical_id t.G t.cub

