      PinChL (_root_.GlobalTheory.Fam.pk_z W) f.g (f.col t) c₀ A ι w) ∧
    ∃ UT ε, PinTopL (_root_.GlobalTheory.Fam.pk_z W) f.g (_root_.GlobalTheory.Fam.complexLevelStructure W) (t := t) (f.col t) UT ε
