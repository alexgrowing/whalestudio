    Γ.M' hM.triple.geo.hM' (crd W₁.gram hG e) (fun u => by simp [crd])).1
  obtain ⟨Φ, hΦ, hd⟩ := key (fockF ψ θ false A₁ B g P) (Submodule.subset_span ⟨g, P, hg, rfl⟩)
