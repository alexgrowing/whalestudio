  first | exact @_root_.GlobalTheory.KSFull.kodaira_spencer_full | exact _root_.GlobalTheory.KSFull.kodaira_spencer_full | (intros; apply _root_.GlobalTheory.KSFull.kodaira_spencer_full <;> assumption)
